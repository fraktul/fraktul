       "t": 0,
       "focus": [
        "flags"
       ]
      },
      {
       "t": 7.42,
       "focus": [
        "cart",
        "payment"
       ]
      }
     ],
     "captions": [
      {
       "t": 0,
       "end": 2,
       "text": "Next, the switches."
      },
      {
       "t": 2.32,
       "end": 6.92,
       "text": "Several services ask a flag service how they should behave."
      },
      {
       "t": 7.42,
       "end": 10.2,
       "text": "The cart and payment are two of them."
      },
      {
       "t": 10.52,
       "end": 15.64,
       "text": "A real shop uses this to turn a new feature on for a few customers."
      },
      {
       "t": 15.96,
       "end": 22.36,
       "text": "This demo uses it to break things on purpose, so people can practise finding the fault."
      }
     ]
    },
