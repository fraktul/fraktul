     "cues": [
      {
       "t": 0,
       "focus": [
        "load_generator"
       ]
      },
      {
       "t": 6.42,
       "focus": [
        "storefront"
       ]
      }
     ],
     "captions": [
      {
       "t": 0,
       "end": 2,
       "text": "Last, the traffic."
      },
      {
       "t": 2.32,
       "end": 5.92,
       "text": "A script pretends to be many shoppers at once."
      },
      {
       "t": 6.42,
       "end": 11.84,
       "text": "It browses, fills carts and places orders through the storefront, all day."
      },
