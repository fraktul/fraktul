  "keeping-the-shop-running": {
   "voice": "am_michael",
   "model": "mlx-community/Kokoro-82M-bf16",
   "rendered": "2026-11-27T18:25:48.739Z",
   "steps": {
    "keeping-the-shop-running-1": {
     "file": "voice/keeping-the-shop-running/keeping-the-shop-running-1.mp3",
     "duration": 23.81,
     "cues": [
      {
       "t": 6.88,
       "focus": [
        "cart"
       ]
      },
      {
       "t": 10.93,
       "focus": [
        "cart_store"
       ]
