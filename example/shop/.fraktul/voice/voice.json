       "text": "That is one order, from the click to the books."
      }
     ]
    }
   }
  },
  "how-a-page-is-built": {
   "voice": "am_michael",
   "model": "mlx-community/Kokoro-82M-bf16",
   "rendered": "2026-11-27T18:25:42.823Z",
   "steps": {
    "how-a-page-is-built-1": {
     "file": "voice/how-a-page-is-built/how-a-page-is-built-1.mp3",
     "duration": 18.07,
     "cues": [
      {
       "t": 4.17,
       "focus": [
        "browser"
       ]
      },
      {
       "t": 7.28,
       "focus": [
        "proxy"
       ]
      }
     ],
     "captions": [
      {
       "t": 0,
       "end": 3.67,
       "text": "What happens when a shopper opens a product page?"
      },
      {
       "t": 4.17,
       "end": 6.78,
       "text": "The browser asks for the page."
      },
      {
       "t": 7.28,
       "end": 10.35,
       "text": "But it never talks to a service directly."
      },
      {
       "t": 10.67,
       "end": 17.75,
       "text": "Every request goes through one door first: a proxy, which decides where each request should go."
      }
     ]
    },
    "how-a-page-is-built-2": {
     "file": "voice/how-a-page-is-built/how-a-page-is-built-2.mp3",
     "duration": 23.63,
     "cues": [
      {
       "t": 0,
       "focus": [
        "pages"
       ]
      },
      {
       "t": 9.89,
       "focus": [
        "api"
       ]
      }
     ],
     "captions": [
      {
       "t": 0,
       "end": 4.75,
       "text": "The proxy hands the request to the web app, which draws the page."
      },
      {
       "t": 5.07,
       "end": 9.39,
       "text": "The page needs data, and the web app does not own any."
      },
      {
       "t": 9.89,
       "end": 12.59,
       "text": "So it calls its own API routes."
      },
      {
       "t": 12.91,
       "end": 18.86,
       "text": "There is one for products, one for the cart, one for recommendations, and so on."
      },
      {
       "t": 19.18,
       "end": 23.31,
       "text": "Click any of them on this map and you can read its code."
      }
     ]
    },
    "how-a-page-is-built-3": {
     "file": "voice/how-a-page-is-built/how-a-page-is-built-3.mp3",
     "duration": 21.01,
     "cues": [
      {
       "t": 0,
       "focus": [
        "storefront",
        "product_catalog"
       ]
      }
     ],
     "captions": [
      {
       "t": 0,
       "end": 4.5,
       "text": "The first question is the obvious one: what is this product?"
      },
      {
       "t": 4.82,
       "end": 12.14,
       "text": "The storefront asks the product catalog, which is the one place in the system that knows what the shop sells."
      },
      {
       "t": 12.46,
       "end": 16.09,
       "text": "The storefront asks no other service as often."
      },
      {
       "t": 16.41,
       "end": 20.69,
       "text": "Select the catalog and its panel shows you how often."
      }
     ]
    },
    "how-a-page-is-built-4": {
     "file": "voice/how-a-page-is-built/how-a-page-is-built-4.mp3",
     "duration": 21.33,
     "cues": [
      {
       "t": 0,
       "focus": [
        "recommendation"
       ]
      },
      {
       "t": 7.34,
       "focus": [
        "product_catalog"
       ]
      }
     ],
     "captions": [
      {
       "t": 0,
       "end": 2.9,
       "text": "Next, what else might this shopper like?"
      },
      {
       "t": 3.22,
       "end": 6.84,
       "text": "The storefront asks the recommendation service."
      },
      {
       "t": 7.34,
       "end": 11.14,
       "text": "And recommendations has a question of its own."
      },
      {
       "t": 11.46,
       "end": 16.24,
       "text": "It asks the catalog which products exist, before it picks some."
      },
      {
       "t": 16.56,
       "end": 21.01,
       "text": "So one page view has already caused two calls to the catalog."
      }
     ]
    },
    "how-a-page-is-built-5": {
     "file": "voice/how-a-page-is-built/how-a-page-is-built-5.mp3",
     "duration": 20.81,
     "cues": [
      {
       "t": 0,
       "focus": [
        "ad"
       ]
      },
      {
       "t": 7.39,
       "focus": [
        "image_provider"
       ]
      }
     ],
     "captions": [
      {
       "t": 0,
       "end": 1.52,
       "text": "Two more."
      },
      {
       "t": 1.84,
       "end": 6.89,
       "text": "The advert service picks an advert that matches what is on the page."
      },
      {
       "t": 7.39,
       "end": 12.42,
       "text": "And the photos come from a plain web server with a folder of images."
      },
      {
       "t": 12.74,
       "end": 20.49,
       "text": "That is one product page: one request from the browser, and four services answering behind the storefront."
      }
