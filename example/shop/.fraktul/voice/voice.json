{
 "tours": {
  "the-shop-in-two-minutes": {
   "voice": "am_michael",
   "model": "mlx-community/Kokoro-82M-bf16",
   "rendered": "2026-11-27T18:25:29.493Z",
   "steps": {
    "the-shop-in-two-minutes-1": {
     "file": "voice/the-shop-in-two-minutes/the-shop-in-two-minutes-1.mp3",
     "duration": 28.08,
     "cues": [
      {
       "t": 13.77,
       "focus": [
        "shopper",
        "storefront"
       ]
      }
     ],
     "captions": [
      {
       "t": 0,
       "end": 5.28,
       "text": "This is the Astronomy Shop, an online shop that sells telescopes."
      },
      {
       "t": 5.6,
       "end": 13.27,
       "text": "It is the demo application of the OpenTelemetry project, and it is made of about twenty small services."
      },
      {
       "t": 13.77,
       "end": 17.57,
       "text": "Everything starts with a shopper opening the website."
      },
      {
       "t": 17.89,
       "end": 22.41,
       "text": "The storefront is the only part of the system they ever see."
      },
      {
       "t": 22.73,
       "end": 27.76,
       "text": "Everything else on this map exists to answer the storefront's questions."
      }
     ]
    },
    "the-shop-in-two-minutes-2": {
     "file": "voice/the-shop-in-two-minutes/the-shop-in-two-minutes-2.mp3",
     "duration": 19.19,
     "cues": [
      {
       "t": 4.02,
       "focus": [
        "browsing"
       ]
      },
      {
       "t": 12.55,
       "focus": [
        "basket"
       ]
      }
     ],
     "captions": [
      {
       "t": 0,
       "end": 3.52,
       "text": "The storefront does not know the products itself."
      },
      {
       "t": 4.02,
       "end": 12.05,
       "text": "It asks one group of services what is for sale: the catalog, the recommendations, the adverts and the photos."
      },
      {
       "t": 12.55,
       "end": 16.7,
       "text": "And it asks another to remember what the shopper has picked."
      },
      {
       "t": 17.02,
       "end": 18.87,
       "text": "That is the cart."
      }
     ]
    },
    "the-shop-in-two-minutes-3": {
     "file": "voice/the-shop-in-two-minutes/the-shop-in-two-minutes-3.mp3",
     "duration": 18.23,
     "cues": [
      {
       "t": 0,
       "focus": [
        "checkout"
       ]
      }
     ],
     "captions": [
      {
       "t": 0,
       "end": 3.73,
       "text": "When the shopper presses pay, checkout takes over."
      },
      {
       "t": 4.04,
       "end": 6.62,
       "text": "Think of it as the conductor."
      },
      {
       "t": 6.94,
       "end": 10.14,
       "text": "It does very little of the work itself."
      },
      {
       "t": 10.46,
       "end": 17.91,
       "text": "Every other step of the order happens because checkout asked another service to do it, in the right order."
      }
     ]
    },
    "the-shop-in-two-minutes-4": {
     "file": "voice/the-shop-in-two-minutes/the-shop-in-two-minutes-4.mp3",
     "duration": 16.71,
     "cues": [
      {
       "t": 0,
       "focus": [
        "paying"
       ]
      },
      {
       "t": 8.39,
       "focus": [
        "delivery"
       ]
      }
     ],
     "captions": [
      {
       "t": 0,
       "end": 1.82,
       "text": "First the money."
      },
      {
       "t": 2.15,
       "end": 7.89,
       "text": "Checkout has the price worked out in the shopper's currency, and has the card charged."
      },
      {
       "t": 8.39,
       "end": 10.24,
       "text": "Then the parcel."
      },
      {
       "t": 10.56,
       "end": 16.39,
       "text": "Checkout has the delivery booked, and a confirmation sent to the shopper by email."
      }
     ]
    },
    "the-shop-in-two-minutes-5": {
     "file": "voice/the-shop-in-two-minutes/the-shop-in-two-minutes-5.mp3",
     "duration": 15.94,
     "cues": [
      {
       "t": 0,
       "focus": [
        "back_office"
       ]
      }
     ],
     "captions": [
      {
       "t": 0,
       "end": 5.45,
       "text": "At this point the shopper is done, and they are not kept waiting for the paperwork."
      },
      {
       "t": 5.77,
       "end": 15.62,
       "text": "Checkout announces the order, and two other services pick it up in their own time: accounting, which records it, and fraud detection, which checks it."
      }
     ]
    },
    "the-shop-in-two-minutes-6": {
     "file": "voice/the-shop-in-two-minutes/the-shop-in-two-minutes-6.mp3",
     "duration": 20.61,
     "cues": [
      {
       "t": 0,
       "focus": [
        "operations"
       ]
      }
     ],
     "captions": [
      {
       "t": 0,
       "end": 3.48,
       "text": "One last group is not part of shopping at all."
      },
      {
       "t": 3.79,
       "end": 12.39,
       "text": "It holds the switches that change how services behave while they are running, and the pretend shoppers that keep this demo busy."
      },
      {
       "t": 12.71,
       "end": 14.81,
       "text": "That is the whole shop."
      },
      {
       "t": 15.13,
       "end": 20.29,
       "text": "Every box you have seen opens, so click any of them to go inside."
      }
     ]
    }
   }
  },
  "follow-one-order": {
   "voice": "am_michael",
   "model": "mlx-community/Kokoro-82M-bf16",
   "rendered": "2026-11-27T18:25:36.510Z",
   "steps": {
    "follow-one-order-1": {
     "file": "voice/follow-one-order/follow-one-order-1.mp3",
     "duration": 21.36,
     "cues": [
      {
       "t": 3.45,
       "focus": [
        "storefront"
       ]
      },
      {
       "t": 6.58,
       "focus": [
        "checkout"
       ]
      }
     ],
     "captions": [
      {
       "t": 0,
       "end": 2.95,
       "text": "Let's follow one order through the shop."
      },
      {
       "t": 3.45,
       "end": 6.08,
       "text": "The shopper presses Place order."
      },
      {
       "t": 6.58,
       "end": 14.28,
       "text": "The storefront sends checkout three things: who the shopper is, where the parcel should go, and the card to charge."
      },
      {
       "t": 14.6,
       "end": 17.7,
       "text": "It makes that call over gRPC."
      },
      {
       "t": 18.02,
       "end": 21.04,
       "text": "From here on, checkout is in charge."
      }
     ]
    },
    "follow-one-order-2": {
     "file": "voice/follow-one-order/follow-one-order-2.mp3",
     "duration": 22.95,
     "cues": [
      {
       "t": 0,
       "focus": [
        "cart"
       ]
      },
      {
       "t": 5.33,
       "focus": [
        "product_catalog"
       ]
      }
     ],
     "captions": [
      {
       "t": 0,
       "end": 4.83,
       "text": "First, checkout asks the cart service what the shopper is buying."
      },
      {
       "t": 5.33,
       "end": 9.65,
       "text": "Then it asks the product catalog for the price of each item."
      },
      {
       "t": 9.97,
       "end": 12.52,
       "text": "Notice what it does not do."
      },
      {
       "t": 12.84,
       "end": 16.11,
       "text": "It does not take the prices from the browser."
      },
      {
       "t": 16.43,
       "end": 22.63,
       "text": "A browser can be made to say anything, so the catalog's price is the one that counts."
      }
     ]
    },
    "follow-one-order-3": {
     "file": "voice/follow-one-order/follow-one-order-3.mp3",
     "duration": 16.5,
     "cues": [
      {
       "t": 0,
       "focus": [
        "currency"
       ]
      }
     ],
     "captions": [
      {
       "t": 0,
       "end": 3.65,
       "text": "The catalog keeps its prices in one currency."
      },
      {
       "t": 3.97,
       "end": 6.64,
       "text": "The shopper may have chosen another."
      },
      {
       "t": 6.96,
       "end": 12.04,
       "text": "So checkout hands each price to the currency service, which converts it."
      },
      {
       "t": 12.36,
       "end": 16.18,
       "text": "The currency service is written in C++."
      }
     ]
    },
    "follow-one-order-4": {
     "file": "voice/follow-one-order/follow-one-order-4.mp3",
     "duration": 19.51,
     "cues": [
      {
       "t": 0,
       "focus": [
        "payment"
       ]
      }
     ],
     "captions": [
      {
       "t": 0,
       "end": 1.73,
       "text": "Now the money."
      },
      {
       "t": 2.04,
       "end": 9.14,
       "text": "Checkout adds up the items and the shipping, and asks the payment service to charge the card for the total."
      },
      {
       "t": 9.46,
       "end": 15.12,
       "text": "If the charge fails, the order stops here, and nothing after this step happens."
      },
      {
       "t": 15.44,
       "end": 19.19,
       "text": "In this demo no real card is ever charged."
      }
     ]
    },
    "follow-one-order-5": {
     "file": "voice/follow-one-order/follow-one-order-5.mp3",
     "duration": 13.36,
     "cues": [
      {
       "t": 0,
       "focus": [
        "shipping"
       ]
      }
     ],
     "captions": [
      {
       "t": 0,
       "end": 4.4,
       "text": "With the money taken, checkout goes back to the shipping service."
      },
      {
       "t": 4.72,
       "end": 7.52,
       "text": "Earlier it asked shipping for a price."
      },
      {
       "t": 7.84,
       "end": 13.04,
       "text": "Now it asks shipping to book the delivery, and gets a tracking number back."
      }
     ]
    },
    "follow-one-order-6": {
     "file": "voice/follow-one-order/follow-one-order-6.mp3",
     "duration": 17.71,
     "cues": [
      {
       "t": 2.52,
       "focus": [
        "email"
       ]
      },
      {
       "t": 8.1,
       "focus": [
        "order_events"
       ]
      }
     ],
     "captions": [
      {
       "t": 0,
       "end": 2.02,
       "text": "Two things are left."
      },
      {
       "t": 2.52,
       "end": 7.6,
       "text": "Checkout asks the email service to send the shopper a confirmation."
      },
      {
       "t": 8.1,
       "end": 13.07,
       "text": "And it puts one message on a queue, saying that this order was placed."
      },
      {
       "t": 13.39,
       "end": 17.39,
       "text": "Checkout does not know or care who reads that message."
      }
     ]
    },
    "follow-one-order-7": {
     "file": "voice/follow-one-order/follow-one-order-7.mp3",
     "duration": 24.36,
     "cues": [
      {
       "t": 0,
       "focus": [
        "order_events"
       ]
      },
      {
       "t": 4.2,
       "focus": [
        "accounting"
       ]
      },
      {
       "t": 9.7,
       "focus": [
        "fraud_detection"
       ]
      }
     ],
     "captions": [
      {
       "t": 0,
       "end": 3.7,
       "text": "The queue is where the order leaves checkout's hands."
      },
      {
       "t": 4.2,
       "end": 9.2,
       "text": "Accounting reads the message and records the order in its database."
      },
      {
       "t": 9.7,
