// fraktul.dev: a static-assets Worker. Production deploys from main (`npm run deploy`); every other branch uploads a
// preview version with its own URL (`npm run deploy:preview`). See .github/workflows/ci.yml and DEPLOYMENT.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fraktul",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site-dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": true,
  // Routes, not custom domains: fraktul.dev and www already have proxied DNS records, and a route answers on top of
  // them (the origin behind those records is never contacted).
  "routes": [
    { "pattern": "fraktul.dev/*", "zone_name": "fraktul.dev" },
    { "pattern": "www.fraktul.dev/*", "zone_name": "fraktul.dev" }
  ]
}
